schema = 2
recent = []

[display]
hotplug = "automatic"
settle_ms = 250
poll_ms = 1000
inhibit_screensaver = true
blank_color = "black"

[display.roles]
presenter = "Auto"
audience = "Auto"
audience_fullscreen = true
allow_shared_display = false

[rendering]
workers = 6
cache_budget_mib = 256
coarse_width = 640
worker_deadline_secs = 10
watch_document = true
watch_debounce_ms = 300

[notes]
default_mapping = "SlidesOnly"
honour_metadata_contract = false
detect_split = true
per_document = []

[timer]
count_down = false
start_on_first_navigation = true
alarms = []
snooze_minutes = 5

[keymap]
bindings = [
    [
    { kind = "named", key = "Right" },
    "next",
],
    [
    { kind = "named", key = "Down" },
    "next",
],
    [
    { kind = "named", key = "Space" },
    "next",
],
    [
    { kind = "named", key = "PageDown" },
    "next",
],
    [
    { kind = "named", key = "Enter" },
    "next",
],
    [
    { kind = "named", key = "Left" },
    "previous",
],
    [
    { kind = "named", key = "Up" },
    "previous",
],
    [
    { kind = "named", key = "PageUp" },
    "previous",
],
    [
    { kind = "named", key = "Backspace" },
    "previous",
],
    [
    { kind = "named", key = "Home" },
    "first",
],
    [
    { kind = "named", key = "End" },
    "last",
],
    [
    { kind = "named", key = "Tab" },
    "preview-next",
],
    [
    { kind = "named", key = "ShiftTab" },
